generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum TableArea {
  TABLE
  BAR
}

enum AnalyticsEventType {
  PAGE_VIEW
  MENU_VIEW
  PRODUCT_VIEW
  WHATSAPP_CART
}

model Admin {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, expiresAt])
}

model AppConfig {
  id                     String   @id @default("default")
  publicName             String?
  publicDescription      String?
  logoUrl                String?
  contactPhone           String?
  showObservedDiscounts  Boolean  @default(false)
  observedDiscountMaxAgeHours Int @default(72)
  updatedAt              DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  externalId  Int
  branchId    Int
  name        String
  description String?
  active      Boolean   @default(true)
  syncedAt    DateTime  @default(now())
  products    Product[]
  @@index([branchId, active])
  @@unique([externalId, branchId])
}

model Product {
  id              String        @id @default(uuid())
  externalId      Int
  branchId        Int
  code            String?
  name            String
  menuDescription String?
  longDescription String?
  price           Decimal       @db.Decimal(12, 2)
  categoryId      String?
  sourceCategoryId Int?
  active          Boolean       @default(true)
  lastValidSyncAt DateTime      @default(now())
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  optionGroups    OptionGroup[]
  priceHistory    PriceHistory[]
  carts           PreparedCart[]
  @@unique([externalId, branchId])
  @@index([categoryId, active])
}

model OptionGroup {
  id         String           @id @default(uuid())
  externalId Int
  productId  String
  name       String
  required   Boolean          @default(false)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  @@unique([productId, externalId])
}

model ProductVariant {
  id          String      @id @default(uuid())
  externalId  Int
  optionGroupId String
  name        String
  priceDelta  Decimal     @db.Decimal(12, 2)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  @@unique([optionGroupId, externalId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  productId   String
  price       Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  isPriceDecrease Boolean @default(false)
  reductionPercent Decimal? @db.Decimal(7, 4)
  observedAt  DateTime @default(now())
  syncRunId   String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  syncRun     SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  @@index([productId, observedAt])
}

model OfferConfig {
  id                     String   @id @default("default")
  enabled                Boolean  @default(false)
  maxObservationAgeHours Int      @default(72)
  updatedAt              DateTime @updatedAt
}

model Advertisement {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String?
  targetUrl String?
  active    Boolean  @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessHours {
  id        String   @id @default(uuid())
  dayOfWeek Int
  opensAt   String?
  closesAt  String?
  closed    Boolean  @default(false)
  @@unique([dayOfWeek])
}

model VenueTable {
  id        String    @id @default(uuid())
  code      String    @unique
  label     String
  area      TableArea
  active    Boolean   @default(true)
  qr        QrIdentifier?
}

model QrIdentifier {
  id        String     @id @default(uuid())
  token     String     @unique
  tableId   String?    @unique
  active    Boolean    @default(true)
  table     VenueTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
}

model ComplementaryGoodRule {
  id                  String   @id @default(uuid())
  productExternalId   Int
  complementaryExternalId Int
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  @@unique([productExternalId, complementaryExternalId])
}

model AnalyticsEvent {
  id        String             @id @default(uuid())
  type      AnalyticsEventType
  path      String?
  productId String?
  metadata  Json?
  createdAt DateTime           @default(now())
  @@index([type, createdAt])
}

model PreparedCart {
  id        String   @id @default(uuid())
  productId String?
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([expiresAt])
}

model SyncRun {
  id            String      @id @default(uuid())
  status        SyncStatus  @default(RUNNING)
  branchId      Int
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  categoryCount Int         @default(0)
  productCount  Int         @default(0)
  errorCode     String?
  errorMessage  String?
  priceHistory  PriceHistory[]
  @@index([branchId, startedAt])
}

model SyncLock {
  id          String   @id
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, createdAt])
}
