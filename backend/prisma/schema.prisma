generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum TableArea {
  TABLE
  BAR
}

enum ThemeMode {
  AUTOMATIC
  DARK
  LIGHT
}
enum PromotionStatus {
  APPROVED
  REJECTED
  SUSPENDED
}
enum PromotionSystemEventType {
  PRICE_CHANGED
  PRODUCT_INACTIVE
  INVALID_OFFICIAL_PRICE
  HISTORICAL_REFERENCE_EXPIRED
  PROMOTION_EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum AnalyticsEventType {
  PAGE_VIEW
  MENU_VIEW
  PRODUCT_VIEW
  WHATSAPP_CART
}

enum CampaignType {
  NONE
  YEAR_ROUND
  CHRISTMAS
  NEW_YEAR
  SUMMER
}

enum CampaignPlacement {
  HOME_AFTER_SERVICES
  HOME_AFTER_PROMOS
  BOWLING_AFTER_INCLUDES
  BOWLING_AFTER_PROMOS
  POOL_AFTER_ENVIRONMENT
  POOL_AFTER_TOURNAMENTS
  EVENTS_AFTER_INCLUDES
  EVENTS_AFTER_PLANS
  CONTACT_AFTER_INFO
  CONTACT_AFTER_HOURS
  MENU_AFTER_INTRO
  MENU_QR_AFTER_GENERATOR
  BOWLING_RULES_AFTER_INTRO
}

model Admin {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  promotions   Promotion[]
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, expiresAt])
}

model AppConfig {
  id                     String   @id @default("default")
  publicName             String?
  publicDescription      String?
  logoUrl                String?
  contactPhone           String?
  showObservedDiscounts  Boolean  @default(false)
  observedDiscountMaxAgeHours Int @default(72)
  themeMode              ThemeMode @default(AUTOMATIC)
  updatedAt              DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  externalId  Int
  branchId    Int
  name        String
  description String?
  active      Boolean   @default(true)
  syncedAt    DateTime  @default(now())
  products    Product[]
  @@index([branchId, active])
  @@unique([externalId, branchId])
}

model Product {
  id              String        @id @default(uuid())
  externalId      Int
  branchId        Int
  code            String?
  name            String
  menuDescription String?
  longDescription String?
  price           Decimal       @db.Decimal(12, 2)
  categoryId      String?
  sourceCategoryId Int?
  active          Boolean       @default(true)
  lastValidSyncAt DateTime      @default(now())
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  optionGroups    OptionGroup[]
  priceHistory    PriceHistory[]
  carts           PreparedCart[]
  promotions      Promotion[]
  orderItems      OrderItem[]
  @@unique([externalId, branchId])
  @@index([categoryId, active])
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  idempotencyKey String?     @unique
  idempotencyFingerprint String?
  branchId       Int
  venueTableId   String?
  venueCode      String?
  venueLabel     String?
  status         OrderStatus @default(PENDING)
  currency       String      @default("ARS") @db.Char(3)
  subtotal       Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  venueTable     VenueTable? @relation(fields: [venueTableId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  @@index([branchId, createdAt])
  @@index([status, createdAt])
  @@index([venueTableId, createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@index([productId])
}

model Promotion {
  id String @id @default(uuid())
  productId String
  previousPrice Decimal @db.Decimal(12,2)
  currentPrice Decimal @db.Decimal(12,2)
  previousObservedAt DateTime
  approvedAt DateTime?
  approvedById String?
  status PromotionStatus @default(REJECTED)
  expiresAt DateTime?
  placements String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  approvedBy Admin? @relation(fields:[approvedById], references:[id], onDelete:SetNull)
  systemEvents PromotionSystemEvent[]
  @@index([productId,status])
}
model PromotionSystemEvent {
  id String @id @default(uuid())
  promotionId String
  eventType PromotionSystemEventType
  reason String
  createdAt DateTime @default(now())
  promotion Promotion @relation(fields:[promotionId], references:[id], onDelete:Restrict)
  @@index([promotionId, createdAt])
}

model OptionGroup {
  id         String           @id @default(uuid())
  externalId Int
  productId  String
  name       String
  required   Boolean          @default(false)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  @@unique([productId, externalId])
}

model ProductVariant {
  id          String      @id @default(uuid())
  externalId  Int
  optionGroupId String
  name        String
  priceDelta  Decimal     @db.Decimal(12, 2)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  @@unique([optionGroupId, externalId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  productId   String
  price       Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  isPriceDecrease Boolean @default(false)
  reductionPercent Decimal? @db.Decimal(7, 4)
  observedAt  DateTime @default(now())
  syncRunId   String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  syncRun     SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  @@index([productId, observedAt])
}

model OfferConfig {
  id                     String   @id @default("default")
  enabled                Boolean  @default(false)
  showHomePromotions     Boolean  @default(false)
  maxObservationAgeHours Int      @default(72)
  updatedAt              DateTime @updatedAt
}

model Advertisement {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String?
  targetUrl String?
  active    Boolean  @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignConfig {
  id             String       @id @default("default")
  activeCampaign CampaignType @default(NONE)
  updatedAt      DateTime     @updatedAt
}

model CampaignVideo {
  id          String            @id @default(uuid())
  campaign    CampaignType
  name        String
  desktopUrl  String
  mobileUrl   String
  posterUrl   String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  placements  CampaignVideoPlacement[]
  @@index([campaign, active])
}

model CampaignVideoPlacement {
  id        String            @id @default(uuid())
  videoId   String
  placement CampaignPlacement
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  video     CampaignVideo     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@unique([videoId, placement])
  @@index([placement, active, sortOrder])
}

model BusinessHours {
  id        String   @id @default(uuid())
  dayOfWeek Int
  opensAt   String?
  closesAt  String?
  closed    Boolean  @default(false)
  @@unique([dayOfWeek])
}

model VenueTable {
  id        String        @id @default(uuid())
  code      String        @unique
  label     String
  area      TableArea
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  qr        QrIdentifier?
  orders    Order[]
}

model QrIdentifier {
  id        String     @id @default(uuid())
  token     String     @unique
  tableId   String?    @unique
  active    Boolean    @default(true)
  table     VenueTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
}

model ComplementaryGoodRule {
  id                  String   @id @default(uuid())
  productExternalId   Int
  complementaryExternalId Int
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  @@unique([productExternalId, complementaryExternalId])
}

model AnalyticsEvent {
  id        String             @id @default(uuid())
  type      AnalyticsEventType
  path      String?
  productId String?
  metadata  Json?
  createdAt DateTime           @default(now())
  @@index([type, createdAt])
}

model PreparedCart {
  id        String   @id @default(uuid())
  productId String?
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([expiresAt])
}

model SyncRun {
  id            String      @id @default(uuid())
  status        SyncStatus  @default(RUNNING)
  branchId      Int
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  categoryCount Int         @default(0)
  productCount  Int         @default(0)
  errorCode     String?
  errorMessage  String?
  priceHistory  PriceHistory[]
  @@index([branchId, startedAt])
}

model SyncLock {
  id          String   @id
  ownerToken  String?
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, createdAt])
}
