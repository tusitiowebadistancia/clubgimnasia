# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/bowling_club?schema=public
APP_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=https://bowlingclubgimnasia.com
SESSION_COOKIE_NAME=bcg_admin_session
CSRF_COOKIE_NAME=bcg_csrf
SESSION_TTL_HOURS=12

# NegoPlus: only the server reads these values. Do not prefix with VITE_.
NEGOPLUS_BASE_URL=https://bowlinggimnasia.negoplus.com.ar
NEGOPLUS_BRANCH_ID=5
# Optional JSON headers supplied by NegoPlus. Never publish this value.
NEGOPLUS_HEADERS_JSON={}
NEGOPLUS_TIMEOUT_MS=10000
SYNC_INTERVAL_MINUTES=15
# Keep true for local development. Set false on Render when Cloudflare Cron invokes /api/internal/sync.
SYNC_LOCAL_SCHEDULER_ENABLED=true
# Required in production. Generate a random value with at least 32 characters and set it only as a server secret.
# INTERNAL_SYNC_TOKEN=

# Frontend: disabled until the QR order-confirmation flow is explicitly enabled.
VITE_ENABLE_ORDER_REGISTRATION=false

# Used once by `npm run admin:bootstrap`; never place these values in a committed file.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-unique-passphrase
